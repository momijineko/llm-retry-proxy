# =============================================================================
# Docker 与运行环境
# =============================================================================

# 容器时区（影响日志时间）。
TZ=Asia/Shanghai

# Docker 基础镜像由两部分拼成完整引用：DOCKER_REGISTRY/PYTHON_BASE_IMAGE。
# DOCKER_REGISTRY 为仓库域名(纯域名、不带尾斜杠)，换镜像站时只改这里。
# PYTHON_BASE_IMAGE 为命名空间/镜像名:tag，跟具体镜像走。
# 默认使用 Docker Hub；国内无代理构建可改用完整模板 .env.cn.example。
# 注意：镜像引用语法不支持 http(s):// 前缀，Docker 默认以 HTTPS 拉取。
# 如遇仅支持 HTTP 的 registry 则需在 ~/.docker/daemon.json 的 insecure-registries 中声明。
DOCKER_REGISTRY=docker.io
PYTHON_BASE_IMAGE=library/python:3.12-slim

# Docker 构建使用的 PyPI 镜像。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple


# =============================================================================
# 服务与访问控制
# =============================================================================

LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
# Uvicorn 事件循环；旧内核兼容模板会覆盖为 asyncio。
UVICORN_LOOP=auto

# 管理页面密码；未配置时 /stats*、/logs* 和 /key-pools 禁用。
ADMIN_PASSWORD=

# HTTPS 部署时设为 true，使登录 Cookie 仅通过 HTTPS 发送。
ADMIN_COOKIE_SECURE=false

# 是否启用配置中心页面（/settings）；关闭时页面与导航入口不展示。
SETTINGS_PAGE_ENABLED=false

# 兼容旧配置：ADMIN_PASSWORD 留空时回退读取 ADMIN_TOKEN。
# ADMIN_TOKEN=

# 下游使用号池的凭据；不匹配时仅作普通透传。
PROXY_API_KEY=

# 拒绝访问的客户端 IP 或 CIDR，多个值用逗号分隔。
# 示例：IP_BLACKLIST=152.32.129.213,198.51.100.0/24
IP_BLACKLIST=

# 仅当请求的直连来源位于这些 IP/CIDR 时，才采信 CF-Connecting-IP、
# X-Forwarded-For 或 X-Real-IP。默认覆盖本机与 Docker 172.x 代理网络。
TRUSTED_PROXY_IPS=127.0.0.0/8,::1,172.16.0.0/12

# 同一客户端在窗口内访问多少个不同路径后自动封禁；0=关闭。
IP_AUTO_BAN_THRESHOLD=20
IP_AUTO_BAN_WINDOW=10
# 0=永久封禁；填写正数表示临时封禁秒数。
IP_AUTO_BAN_DURATION=0

# 不参与动态封禁的 IP/CIDR；静态 IP_BLACKLIST 仍然优先。
IP_AUTO_BAN_EXEMPT=127.0.0.0/8,::1

# 动态封禁状态文件；留空时使用 LOG_DIR/.ip_bans.json。
IP_BAN_STATE_FILE=

# 统计 provider 显示别名，格式为 from:to,from:to。
# PROVIDER_ALIASES=讯飞星辰 Coding Plan:xfyun


# =============================================================================
# 上游、路由与网络
# =============================================================================

# 默认上游地址，不要带尾斜杠。
UPSTREAM_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
PROVIDER=xfyun

# 格式：prefix|url|provider，多组用逗号分隔；转发时去掉匹配前缀。
# 示例：/anthropic|https://api.anthropic.com|anthropic
EXTRA_UPSTREAMS=

# 是否读取 HTTP_PROXY/HTTPS_PROXY/ALL_PROXY；国内上游通常建议直连。
TRUST_ENV=false


# =============================================================================
# Codex Responses WebSocket <-> 上游 HTTP/SSE 双向桥接 (sse2ws 指响应方向)
#   WS -> SSE（请求方向，客户端 -> 上游）：WebSocket response.create -> HTTP/SSE 请求
#   SSE -> WS（响应方向，上游 -> 客户端）：上游 SSE 事件流 -> WebSocket JSON 文本帧
# =============================================================================

# 设为 bridge 开启 /v1/responses WebSocket 入口：Codex CLI 等客户端走
# WebSocket 长连接逐轮发送 response.create，桥接把每轮翻译成上游 HTTP/SSE
# Responses 请求并逐帧转回 WebSocket JSON 事件。off 时不注册 WS 路由，
# 客户端自动回退到普通 HTTP/SSE。
SSE2WS_MODE=off

# 上游已返回响应头但迟迟不发首事件时，判定该次尝试失败的超时（秒）。
SSE2WS_FIRST_EVENT_TIMEOUT=30

# 首事件超时后整轮重试的次数（0 表示不重试）。
SSE2WS_FIRST_EVENT_RETRIES=2

# 连接建立后等待客户端第一条 response.create 的超时（秒）。
SSE2WS_FIRST_MESSAGE_TIMEOUT=30

# 轮与轮之间（等待下一条 response.create）的空闲超时（秒）；超时关闭连接。
SSE2WS_INTER_TURN_IDLE_TIMEOUT=300

# 单轮 response.create 载荷上限（字节），防止超大上下文拖垮内存。
SSE2WS_MAX_BODY_BYTES=67108864


# =============================================================================
# 连接与响应超时（秒）
# =============================================================================

CONNECT_TIMEOUT=10

# 普通读写超时；流式响应中表示相邻两次数据之间的最大间隔。
TIMEOUT=300

# 请求体最大字节数；超出返回 413，防止超大上传耗尽内存。
MAX_REQUEST_BODY=67108864

# 整笔 Responses 请求从开始处理到收到响应头的硬上限；0=不限制。
RESPONSES_HEADER_TIMEOUT=120

# 流式 Responses 号池请求中，单个 key 等待响应头的上限；超时后仅在本请求内换 key，不全局熔断，0=不限制。
RESPONSES_ATTEMPT_HEADER_TIMEOUT=15

# 仅对不超过此大小的请求体启用上述单 key 短超时；大请求使用整笔响应头预算，0=不限大小。
RESPONSES_ATTEMPT_HEADER_TIMEOUT_BODY_LIMIT=1048576

# =============================================================================
# 重试与退避
# =============================================================================

# 最大重试次数；0=无限重试。
MAX_RETRIES=60
RETRY_STATUS_CODES=503,502,504,524,529,429

# 开启后，5xx、429、401/403 和网络异常均触发重试或换 key。
RETRY_BROAD=off

# 非 429 错误：默认固定间隔；开启指数退避后最高等待 60 秒。
RETRY_INTERVAL=1.0
RETRY_BACKOFF=false
RETRY_BACKOFF_MAX=60

# 429：优先尊重 Retry-After，默认启用指数退避。
RETRY_INTERVAL_429=5.0
RETRY_BACKOFF_429=true
RETRY_BACKOFF_MAX_429=60
# 上游 Retry-After 头封顶值（秒）；0=不封顶，完全尊重上游。
RETRY_AFTER_MAX=0

# 避免上游整体故障时一直卡在同一个 key 上重试。0=不限制。


# =============================================================================
# 竞速模式（会增加上游压力）
# =============================================================================

# off=串行重试，race=每轮并发竞速，stagger=交错补发。
HEDGE_MODE=off
MAX_CONCURRENT=10


# =============================================================================
# 号池来源与鉴权
# =============================================================================

# CSV 优先于 KEY_POOLS；复制 key_pool.csv.example 后取消下一行注释。
# KEY_POOL_FILE=key_pool.csv

# 分号分隔 key；多上游格式：url|provider|key1;key2。
KEY_POOLS=

# 自定义上游鉴权头；默认使用 Authorization: Bearer <key>。
# KEY_AUTH_HEADER=authorization
# KEY_AUTH_SCHEME=Bearer


# =============================================================================
# 号池熔断与选择
# =============================================================================

# 旧版兼容值；未配置 KEY_COOLDOWN_5XX 时作为默认冷却时间。
KEY_COOLDOWN=30

KEY_COOLDOWN_5XX=30
KEY_COOLDOWN_429=60
KEY_COOLDOWN_AUTH=1800
KEY_COOLDOWN_MAX=3600
KEY_COOLDOWN_BACKOFF=true

# key 粘性时间；兼顾两者使用固定窗口且窗口内仍会定时复测，其他策略按空闲续期；0=禁用。
KEY_STICKY=120

# 所有候选 key 均熔断时的最长等待时间；超时返回 503，0=不限制。
KEY_POOL_WAIT_TIMEOUT=120

# 兼顾两者/首 Token 策略：真实请求样本有效期、单个便宜分组轮转复测间隔、
# 慢分组升级所需连续样本数，以及上下阈值的滞回比例。
KEY_TTFT_STALE_AFTER=300
KEY_TTFT_RETEST_INTERVAL=60
KEY_TTFT_CONFIRMATIONS=2
KEY_TTFT_HYSTERESIS=0.1

# Responses 返回明确缓存统计时，连续 3 次长输入无缓存会熔断整个分组 1 小时；
# 没有其它可用分组时不会触发。阈值或冷却设为 0 可关闭。
KEY_CACHE_MISS_THRESHOLD=3
KEY_CACHE_MISS_MIN_INPUT_TOKENS=1024
KEY_CACHE_MISS_COOLDOWN=3600


# =============================================================================
# 在线同步
# =============================================================================

KEY_POOL_SYNC_DEFAULT_ADAPTER=sub2api

# 管理页新增连接时预填的上游地址；留空时使用 UPSTREAM_URL。
# KEY_POOL_SYNC_URL=https://aihub.top

# 自动同步周期；0=仅手动同步。
KEY_POOL_SYNC_INTERVAL=300
KEY_POOL_CREATE_DELAY=1.5

# 同步连接、刷新令牌与最近成功号池的持久化文件，权限自动设为 0600。
# KEY_POOL_SYNC_STATE_FILE=/app/logs/.key_pool_sync.json

# 加密状态文件中的凭据字段（密码、令牌、Cookie 等）。留空则回退到
# ADMIN_PASSWORD；两者都未设置时不加密（向后兼容，但凭据以明文落盘）。
# KEY_POOL_SYNC_SECRET=


# =============================================================================
# Token 统计
# =============================================================================

# 开启后，对 OpenAI Chat 流式请求且未带 stream_options 的，自动注入
# stream_options={"include_usage":true} 以确保末帧返回 usage 用于 token 统计。
# 客户端显式声明 include_usage（true/false）时不覆盖；其它 stream_options 字段保留。
# 默认关闭以保持请求体透明透传；不支持 stream_options 的兼容上游应保持关闭。
TOKEN_STATS_INJECT_USAGE=false


# =============================================================================
# 上游兼容
# =============================================================================

# 图片请求覆盖客户端身份，兼容限制默认 Python User-Agent 的上游。
IMAGE_UPSTREAM_USER_AGENT=
IMAGE_UPSTREAM_ORIGINATOR=


# =============================================================================
# 日志
# =============================================================================

LOG_DIR=logs
LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO

# 旧版单文件日志路径，仅用于自动迁移。
# LOG_FILE=retry_log.jsonl


# =============================================================================
# 请求正文敏感信息防护
# =============================================================================

# off=关闭，audit=仅告警，redact=脱敏后转发，block=拦截。
DLP_MODE=off
DLP_RULES=private_key,ai_tokens,code_tokens,cloud_tokens,saas_tokens,package_tokens,credentials,csv_credentials,jwt,connection_string,id_card,bank_card,structured_secret

# 默认读取 retry_proxy/dlp_rules.yaml；也支持自定义 JSON/YAML 文件。
# DLP_RULE_FILE=/app/retry_proxy/dlp_rules.yaml

# 是否允许正文使用固定标记跳过检查。不可信客户端必须保持 false。
DLP_ALLOW_EXEMPTIONS=false
# 启用豁免后，标记区间内跳过检查；默认在转发前移除标记。
DLP_EXEMPT_START=[[ALLOW_SENSITIVE]]
DLP_EXEMPT_END=[[/ALLOW_SENSITIVE]]
DLP_STRIP_EXEMPT_MARKERS=true

# 最大扫描字节数；redact/block 模式下超限返回 413。
DLP_MAX_BODY_BYTES=16777216
# Base64/Base64URL、hex、percent 编码递归扫描限制；0 层表示关闭解码。
DLP_DECODE_DEPTH=2
DLP_DECODE_MAX_CANDIDATES=100
DLP_DECODE_MAX_BYTES=1048576
# 号池 Key 小于该长度时不做精确内容匹配，避免短值误报。
DLP_KNOWN_SECRET_MIN_LENGTH=8
# 非 JSON 或无法解析的正文是否返回 422；默认保留通用透传兼容性。
DLP_FAIL_CLOSED=false
